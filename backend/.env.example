# 고객 A/S 사이트 환경 값 — 이 파일을 .env 로 복사해 값을 채운다. .env 는 저장소에 넣지 않는다.

# NAS PostgreSQL 접속 (고객 사이트 전용 계정)
# 모양: postgresql+psycopg2://<계정>:<비밀번호>@<NAS 주소>:15432/crm_rma
DATABASE_URL=

# 고객 로그인 토큰 서명 키. 새로 만든 긴 무작위 값. CRM 의 값과 같을 필요 없다.
# 비워 두면 운영 DB 에서는 사이트가 열리지 않는다.
SECRET_KEY=

# 사진 폴더 — NAS 공유 폴더의 crm-rma\uploads\as (UNC 경로)
AS_UPLOAD_DIR=

# 요청자 IP 머리말을 믿어도 되는 상대 (같은 서버의 IIS). 보통 그대로 둔다.
TRUSTED_PROXIES=127.0.0.1,::1

# 1분 넘는 영상 자르기 프로그램 (install.md 13절). 비우면 영상을 자르지 않고 원본 그대로 저장한다
FFMPEG_PATH=
# 영상 원본 한 개 한도(MB). 기본 1024 — 바꾸면 web.config 의 maxAllowedContentLength 도 맞춘다
# VIDEO_MAX_MB=1024
