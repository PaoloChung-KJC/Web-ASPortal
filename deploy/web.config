<?xml version="1.0" encoding="utf-8"?>
<!--
  고객 A/S 사이트 — IIS 사이트 설정 (사이트 루트 = Web-ASPortal 폴더에 둔다)

  IIS 가 HttpPlatformHandler 로 프로그램(uvicorn)을 띄우고 모든 요청을 그리로 넘긴다.
  이 파일은 이 사이트에만 걸린다 — 같은 서버의 다른 사이트에는 영향이 없다.

  설치 폴더가 C:\Webproject\Web-ASPortal 이 아니면 아래 경로 세 곳(processPath · arguments 의 app-dir · stdoutLogFile)을 고친다.
  접속 정보 같은 환경 값은 여기에 넣지 않는다. backend\.env 에 둔다.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="ASPortal" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>

    <!-- processesPerApplication="1": 로그인 시도 제한이 프로세스 안 기억이라 프로세스는 반드시 1개
         arguments 끝의 no-proxy-headers 옵션: 요청자 IP 머리말은 uvicorn 이 아니라 app/services/client_ip.py 가 푼다 -->
    <httpPlatform processPath="C:\Webproject\Web-ASPortal\backend\.venv\Scripts\python.exe"
                  arguments="-m uvicorn app.main:app --app-dir C:\Webproject\Web-ASPortal\backend --host 127.0.0.1 --port %HTTP_PLATFORM_PORT% --no-proxy-headers"
                  processesPerApplication="1"
                  startupTimeLimit="60"
                  startupRetryCount="3"
                  stdoutLogEnabled="true"
                  stdoutLogFile="C:\Webproject\Web-ASPortal\logs\portal">
      <environmentVariables>
        <environmentVariable name="PYTHONUTF8" value="1" />
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
      </environmentVariables>
    </httpPlatform>

    <security>
      <requestFiltering>
        <!-- 사진 한 장 8MB + 여유 = 요청 10MB 까지 -->
        <requestLimits maxAllowedContentLength="10485760" />
        <!-- 프로그램 폴더를 IIS 가 파일로 직접 내주지 않게 (모든 요청이 프로그램으로 가지만 한 겹 더) -->
        <hiddenSegments>
          <add segment="backend" />
          <add segment="deploy" />
          <add segment="logs" />
          <add segment=".git" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
